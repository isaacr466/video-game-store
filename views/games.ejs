<%- include("partials/header") %>

<h1>Our Video Games</h1>
<p>Browse our collection of video games.</p>

<div class="games-grid">

    <% games.forEach(game => { %>
        <div class="game-card">

            <img
                src="<%= game.getImage() %>"
                alt="<%= game.title %> cover"
                class="game-cover"
            >

            <h2><%= game.title %></h2>

            <p>Platform: <%= game.platform %></p>

            <p>Price: $<%= game.price.toFixed(2) %></p>

            <p>Description: <%= game.description %></p>

            <p>
                Availability:
                <%= game.isAvailable() ? "In Stock" : "Out of Stock" %>
            </p>

            <% if (game.isAvailable()) { %>
                <form action="/cart/add" method="POST">
                    <input
                        type="hidden"
                        name="gameId"
                        value="<%= game.id %>"
                    >

                    <label>Quantity:</label>
                    <input
                        type="number"
                        name="quantity"
                        value="1"
                        min="1"
                        max="<%= game.quantity %>"
                        required
                    >

                    <button type="submit">Add to Cart</button>
                </form>
            <% } %>

            <a href="/games/<%= game.id %>/reviews">
                View Reviews
            </a>

        </div>
    <% }); %>

</div>

<%- include("partials/footer") %>