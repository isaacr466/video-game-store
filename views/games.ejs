
<%- include("partials/header") %>

<h1>Our Video Games</h1>
<p>Browse our collection of video games.</p>

<% games.forEach(game => { %>
    <div>
        <h2><%= game.title %></h2>

        <p>Platform: <%= game.platform %></p>

        <p>Price: $<%= game.price.toFixed(2) %></p>

        <p>Description: <%= game.description %></p>

        <p>
            Availability:
            <%= game.isAvailable() ? "In Stock" : "Out of Stock" %>
        </p>

        <hr>
    </div>
<% }); %>

<%- include("partials/footer") %>
