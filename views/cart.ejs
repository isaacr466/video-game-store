<%- include("partials/header") %>

<h1>Your Shopping Cart</h1>

<% if (cart.items.length === 0) { %>
    <p>Your shopping cart is empty.</p>
    <a href="/games">Browse Games</a>
<% } else { %>

    <% cart.items.forEach(item => { %>
        <div>
            <h2><%= item.game.title %></h2>

            <p>Platform: <%= item.game.platform %></p>
            <p>Price: $<%= item.game.price.toFixed(2) %></p>

            <form action="/cart/update" method="POST">
                <input type="hidden" name="gameId"
                    value="<%= item.game.id %>">

                <label>Quantity:</label>
                <input type="number" name="quantity"
                    value="<%= item.quantity %>"
                    min="1" max="<%= item.game.quantity %>" required>

                <button type="submit">Update</button>
            </form>

            <form action="/cart/remove" method="POST">
                <input type="hidden" name="gameId"
                    value="<%= item.game.id %>">

                <button type="submit">Remove</button>
            </form>

            <hr>
        </div>
    <% }); %>

    <h2>Total: $<%= cart.getTotal().toFixed(2) %></h2>

    <a href="/games">Continue Shopping</a>

<% } %>

<%- include("partials/footer") %>